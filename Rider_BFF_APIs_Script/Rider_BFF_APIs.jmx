              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">vars.put(&quot;tokenTime&quot;, String.valueOf(System.currentTimeMillis()))

log.info(&quot;Thread &quot; + ctx.getThreadNum()
        + &quot; New Token Generated&quot;)
