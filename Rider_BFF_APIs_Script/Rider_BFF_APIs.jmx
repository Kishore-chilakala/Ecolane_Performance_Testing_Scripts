        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Environment Selection" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def ENVVALUE = vars.get(&quot;Test_Env&quot;);

if (ENVVALUE == &quot;DEMO&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;demo-riderapp.ecolane.com&quot;);
vars.put(&quot;Ecolane-SystemID&quot;,&quot;demo-react-mobile&quot;)

}
else if (ENVVALUE == &quot;BFF&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;qa-riderapp.ecolane.com&quot;);
vars.put(&quot;Ecolane-SystemID&quot;,&quot;qa-react-mobile&quot;);
}
else if (ENVVALUE == &quot;DEV&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;dev-riderapp.ecolane.com&quot;);
vars.put(&quot;Ecolane-SystemID&quot;,&quot;dev-react-mobile&quot;);
}
else if (ENVVALUE == &quot;LETS&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;qa-lets-riderapp.ecolane.com&quot;);
vars.put(&quot;Ecolane-SystemID&quot;,&quot;qa-lets-mobile&quot;);
}

else if (ENVVALUE == &quot;DEVMTS&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;dev-riderapp.ecolane.com&quot;);
vars.put(&quot;Ecolane-SystemID&quot;,&quot;dev-mts-mobile&quot;);
}

else (ENVVALUE == &quot;PROD&quot;)
{
vars.put(&quot;ENVVALUE&quot;,&quot;prod-react.ecolane.com&quot;);

}


</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
