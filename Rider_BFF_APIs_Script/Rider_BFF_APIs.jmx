        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def tokenTime = vars.get(&quot;tokenTime&quot;)

boolean expired = false

if (tokenTime != null &amp;&amp; tokenTime.isLong()) {
    expired = (System.currentTimeMillis() - tokenTime.toLong()) &gt;= 3481000
}

vars.put(&quot;tokenExpired&quot;, expired.toString())

log.info(&quot;Thread=&quot; + ctx.getThreadNum()
        + &quot; Expired=&quot; + expired
        + &quot; TokenTime=&quot; + tokenTime)</stringProp>
        </JSR223Sampler>
