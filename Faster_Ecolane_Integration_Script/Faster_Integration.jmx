            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="false">
              <stringProp name="scriptLanguage">java</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import javax.json.*;
import java.io.StringReader;
import java.util.ArrayList;
import java.util.List;

// Read response
String response = prev.getResponseDataAsString();

// Parse JSON using Java native API
JsonReader reader = Json.createReader(new StringReader(response));
JsonArray jsonArray = reader.readArray();

int total = jsonArray.size();
int parts = 5;

// chunk size
int chunkSize = (int) Math.ceil((double) total / parts);

for (int i = 0; i &lt; parts; i++) {

    int start = i * chunkSize;
    int end = Math.min(start + chunkSize, total);

    JsonArrayBuilder builder = Json.createArrayBuilder();

    for (int j = start; j &lt; end; j++) {
        if (j &lt; total) {
            builder.add(jsonArray.get(j));
        }
    }

    JsonArray slice = builder.build();

    vars.put(&quot;json_part_&quot; + (i + 1), slice.toString());
}
``</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">String response = prev.getResponseDataAsString();

// Remove outer [ and ]
response = response.trim();
if (response.startsWith(&quot;[&quot;)) {
    response = response.substring(1);
}
if (response.endsWith(&quot;]&quot;)) {
    response = response.substring(0, response.length() - 1);
}

// Split JSON objects manually
String[] objects = response.split(&quot;},\\s*\\{&quot;);

int total = objects.length;
int parts = 5;

// chunk size
int chunkSize = (int)Math.ceil((double)total / parts);

for (int i = 0; i &lt; parts; i++) {

    int start = i * chunkSize;
    int end = Math.min(start + chunkSize, total);

    StringBuilder chunk = new StringBuilder();
    chunk.append(&quot;[&quot;);

    for (int j = start; j &lt; end; j++) {

        String obj = objects[j];

        // Fix broken braces after split
        if (!obj.startsWith(&quot;{&quot;)) obj = &quot;{&quot; + obj;
        if (!obj.endsWith(&quot;}&quot;)) obj = obj + &quot;}&quot;;

        chunk.append(obj);

        if (j &lt; end - 1) {
            chunk.append(&quot;,&quot;);
        }
    }

    chunk.append(&quot;]&quot;);

    vars.put(&quot;json_part_&quot; + (i+1), chunk.toString());
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

// Define target IDs
def targetIds = [
    &quot;1FTFW1EF9CFA89516&quot;,
    &quot;1FTFW1EF0CFA89520&quot;
]

// Get response
//String response = prev.getResponseDataAsString();
def response = prev.getResponseDataAsString()

def json = new JsonSlurper().parseText(response)

// Recursive function WITH parameter
def process(obj, targetIds) {
    if (obj instanceof Map) {

        boolean match = obj.values().any { targetIds.contains(it?.toString()) }

        if (match &amp;&amp; obj.containsKey(&quot;isDown&quot;) &amp;&amp; obj.isDown == true) {
            obj.isDown = &quot;Yes&quot;
        }

        obj.each { k, v -&gt;
            process(v, targetIds)
        }

    } else if (obj instanceof List) {
        obj.each { process(it, targetIds) }
    }
}

// Call function correctly
process(json, targetIds)

// Convert back
def updatedJson = JsonOutput.toJson(json)

// Store result
vars.put(&quot;modifiedResponse&quot;, updatedJson)

// Debug log
log.info(&quot;Updated JSON: &quot; + updatedJson)</stringProp>
            </JSR223PostProcessor>
